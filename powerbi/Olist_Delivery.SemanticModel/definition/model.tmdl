model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-ID
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fact_orders","fact_order_items","dim_customer","dim_seller","dim_product"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table fact_orders
ref table fact_order_items
ref table dim_customer
ref table dim_seller
ref table dim_product
ref table Calendar

ref cultureInfo en-US

